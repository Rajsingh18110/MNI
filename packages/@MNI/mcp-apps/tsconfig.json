{
	"extends": "@MNI/typescript-config/tsconfig.common.go.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"rootDirs": [".", "../../frontend/@MNI/design-system/src"],
		"types": [
			"node",
			"vitest/globals",
			"vite/client",
			"unplugin-icons/types/vue",
			"../../frontend/@MNI/design-system/src/shims-modules.d.ts"
		],
		"skipLibCheck": true,
		"paths": {
			"@mcp-apps/*": ["./src/*"],
			"@MNI/design-system": ["../../frontend/@MNI/design-system/src/index.ts"],
			"@MNI/design-system/*": ["../../frontend/@MNI/design-system/src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.vue"]
}
