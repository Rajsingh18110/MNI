{
  "name": "MNI-core",
  "version": "2.41.0",
  "description": "Core functionality of MNI",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "bin": {
    "MNI-copy-static-files": "./bin/copy-static-files",
    "MNI-generate-translations": "./bin/generate-translations",
    "MNI-generate-metadata": "./bin/generate-metadata",
    "MNI-generate-node-defs": "./bin/generate-node-defs"
  },
  "scripts": {
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck && tsc-alias -p tsconfig.build.json",
    "dev": "pnpm watch",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "watch": "tsc-watch -p tsconfig.build.json --onCompilationComplete \"tsc-alias -p tsconfig.build.json\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:changed": "janitor test-scoped",
    "test:dev": "vitest --silent=false"
  },
  "files": [
    "dist",
    "bin"
  ],
  "devDependencies": {
    "@MNI/playwright-janitor": "workspace:*",
    "@MNI/typescript-config": "workspace:*",
    "@MNI/typeorm": "workspace:*",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/lodash": "catalog:",
    "@types/luxon": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/ms": "catalog:",
    "@types/ssh2": "catalog:",
    "@types/uuid": "catalog:",
    "@MNI/vitest-config": "workspace:*",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axios": "catalog:",
    "nock": "catalog:",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:typescript",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "dependencies": {
    "@langchain/core": "catalog:",
    "@MNI/backend-common": "workspace:*",
    "@MNI/backend-network": "workspace:*",
    "@MNI/blob-storage": "workspace:*",
    "@MNI/client-oauth2": "workspace:*",
    "@MNI/config": "workspace:*",
    "@MNI/constants": "workspace:*",
    "@MNI/decorators": "workspace:*",
    "@MNI/di": "workspace:*",
    "@MNI/errors": "workspace:*",
    "@MNI/utils": "workspace:*",
    "@MNI/workflow-sdk": "workspace:*",
    "@sentry/core": "catalog:sentry",
    "@sentry/node": "catalog:sentry",
    "@sentry/node-native": "catalog:sentry",
    "@sentry/profiling-node": "catalog:sentry",
    "callsites": "catalog:",
    "chardet": "2.0.0",
    "cron": "catalog:",
    "fast-glob": "catalog:",
    "file-type": "catalog:",
    "form-data": "catalog:",
    "jsonwebtoken": "catalog:",
    "lodash": "catalog:",
    "luxon": "catalog:",
    "mime-types": "catalog:",
    "ms": "catalog:",
    "MNI-workflow": "workspace:*",
    "nanoid": "catalog:",
    "oauth-1.0a": "2.2.6",
    "p-cancelable": "2.1.1",
    "p-limit": "catalog:",
    "pretty-bytes": "5.6.0",
    "ssh2": "catalog:",
    "uuid": "catalog:"
  },
  "license": "LicenseRef-MNI-sustainable-use"
}
