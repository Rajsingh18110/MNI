{
	"extends": "@MNI/typescript-config/tsconfig.frontend.json",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"rootDirs": [
			".",
			"../@MNI/rest-api-client/src",
			"../@MNI/composables/src",
			"../@MNI/chat/src",
			"../@MNI/design-system/src",
			"../@MNI/frontend-module-sdk/src",
			"../@MNI/frontend-utils/src",
			"../@MNI/frontend-constants/src"
		],
		"noEmit": true,
		"types": [
			"vitest/globals",
			"unplugin-icons/types/vue",
			"vite-svg-loader",
			"../@MNI/design-system/src/shims-modules.d.ts"
		],
		"paths": {
			"@/*": ["./src/*"],
			"@MNI/rest-api-client*": ["../@MNI/rest-api-client/src*"],
			"@MNI/composables*": ["../@MNI/composables/src*"],
			"@MNI/constants*": ["../../@MNI/constants/src*"],
			"@MNI/frontend-module-sdk": ["../@MNI/frontend-module-sdk/src/index.ts"],
			"@MNI/frontend-module-type-availability-policies": [
				"../../modules/type-availability-policies/frontend/src/index.ts"
			],
			"@MNI/frontend-module-type-availability-policies/*": [
				"../../modules/type-availability-policies/frontend/src/*"
			],
			"@MNI/frontend-module-insights": ["../../modules/insights/frontend/src/index.ts"],
			"@MNI/frontend-module-insights/*": ["../../modules/insights/frontend/src/*"],
			"@MNI/frontend-module-instance-registry": [
				"../../modules/instance-registry/frontend/src/index.ts"
			],
			"@MNI/frontend-module-instance-registry/*": [
				"../../modules/instance-registry/frontend/src/*"
			],
			"@MNI/frontend-module-otel": ["../../modules/otel/frontend/src/index.ts"],
			"@MNI/frontend-module-otel/*": ["../../modules/otel/frontend/src/*"],
			"@MNI/frontend-test-utils": ["../@MNI/frontend-test-utils/src/index.ts"],
			"@MNI/frontend-test-utils/*": ["../@MNI/frontend-test-utils/src/*"],
			"@MNI/frontend-utils*": ["../@MNI/frontend-utils/src*"],
			"@MNI/frontend-constants*": ["../@MNI/frontend-constants/src*"],
			"@MNI/chat*": ["../@MNI/chat/src*"],
			"@MNI/chat-hub*": ["../../@MNI/chat-hub/src*"],
			"@MNI/design-system": ["../@MNI/design-system/src/index.ts"],
			"@MNI/design-system/*": ["../@MNI/design-system/src/*"],
			"@MNI/i18n*": ["../@MNI/i18n/src*"],
			"@MNI/stores*": ["../@MNI/stores/src*"],
			"@MNI/telemetry": ["../../@MNI/telemetry/src/index.ts"],
			"@MNI/telemetry*": ["../../@MNI/telemetry/src*"],
			"@MNI/api-types*": ["../../@MNI/api-types/src*"],
			"@MNI/utils*": ["../../@MNI/utils/src*"],
			"@MNI/expression-runtime": ["./vite/expression-runtime-stub.ts"]
		},
		// TODO: remove all options below this line
		"useUnknownInCatchVariables": false
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
	"exclude": ["src/**/*.stories.ts", "src/plugins/codemirror/typescript/worker/**/*.d.ts"]
}
