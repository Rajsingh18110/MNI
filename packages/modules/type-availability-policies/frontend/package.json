{
  "name": "@MNI/frontend-module-type-availability-policies",
  "version": "0.2.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rimraf .turbo",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:changed": "janitor test-scoped",
    "test:dev": "vitest",
    "lint": "eslint src --quiet",
    "lint:fix": "eslint src --fix",
    "format": "biome format --write . && prettier --write . --ignore-path ../../../../.prettierignore",
    "format:check": "biome ci . && prettier --check . --ignore-path ../../../../.prettierignore"
  },
  "dependencies": {
    "@MNI/api-types": "workspace:*",
    "@MNI/design-system": "workspace:*",
    "@MNI/frontend-module-sdk": "workspace:*",
    "@MNI/i18n": "workspace:*",
    "@MNI/rest-api-client": "workspace:*",
    "@MNI/stores": "workspace:*",
    "@MNI/utils": "workspace:*",
    "@vueuse/core": "catalog:frontend",
    "pinia": "catalog:frontend",
    "vue": "catalog:frontend"
  },
  "devDependencies": {
    "@iconify/json": "catalog:",
    "@MNI/eslint-config": "workspace:*",
    "@MNI/frontend-test-utils": "workspace:*",
    "@MNI/frontend-vite-config": "workspace:*",
    "@MNI/playwright-janitor": "workspace:*",
    "@MNI/typescript-config": "workspace:*",
    "@MNI/vitest-config": "workspace:*",
    "@pinia/testing": "^0.1.6",
    "@testing-library/jest-dom": "catalog:frontend",
    "@testing-library/user-event": "catalog:frontend",
    "@testing-library/vue": "catalog:frontend",
    "@vitejs/plugin-vue": "catalog:frontend",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "unplugin-icons": "catalog:frontend",
    "vite": "catalog:",
    "vite-svg-loader": "catalog:frontend",
    "vitest": "catalog:",
    "vue-tsc": "catalog:frontend"
  },
  "license": "LicenseRef-MNI-sustainable-use"
}
