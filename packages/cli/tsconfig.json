{
	"extends": [
		"@MNI/typescript-config/tsconfig.common.go.json",
		"@MNI/typescript-config/tsconfig.backend.go.json"
	],
	"compilerOptions": {
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"lib": ["es2023", "dom"],
		"types": ["node", "vitest/globals", "vite/client"],
		"paths": {
			// Direct cli checks should not require @MNI/telemetry to be built first.
			"@MNI/telemetry": ["../@MNI/telemetry/src/index.ts"],
			"@MNI/telemetry/*": ["../@MNI/telemetry/src/*"],
			"@/*": ["./src/*"],
			"@test/*": ["./test/shared/*"],
			"@test-integration/*": ["./test/integration/shared/*"]
		},
		"strict": true,
		"strictFunctionTypes": false,
		"strictPropertyInitialization": false,
		// TODO: remove all options below this line
		"useUnknownInCatchVariables": false
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "src/sso.ee/saml/saml-schema-metadata-2.0.xsd"],
	"references": [
		{ "path": "../core/tsconfig.build.json" },
		{ "path": "../nodes-base/tsconfig.build.cjs.json" },
		{ "path": "../workflow/tsconfig.build.esm.json" },
		{ "path": "../@MNI/ai-utilities/tsconfig.build.cjs.json" },
		{ "path": "../@MNI/ai-workflow-builder.ee/tsconfig.build.json" },
		{ "path": "../@MNI/instance-ai/tsconfig.build.json" },
		{ "path": "../@MNI/api-types/tsconfig.build.json" },
		{ "path": "../@MNI/client-oauth2/tsconfig.build.json" },
		{ "path": "../@MNI/config/tsconfig.build.json" },
		{ "path": "../@MNI/constants/tsconfig.build.json" },
		{ "path": "../@MNI/decorators/tsconfig.build.json" },
		{ "path": "../@MNI/db/tsconfig.build.json" },
		{ "path": "../@MNI/errors/tsconfig.build.json" },
		{ "path": "../@MNI/backend-common/tsconfig.build.json" },
		{ "path": "../@MNI/backend-test-utils/tsconfig.build.json" },
		{ "path": "../@MNI/blob-storage/tsconfig.build.json" },
		{ "path": "../@MNI/di/tsconfig.build.json" },
		{ "path": "../@MNI/nodes-langchain/tsconfig.build.json" },
		{ "path": "../@MNI/permissions/tsconfig.build.json" },
		{ "path": "../@MNI/scheduler/tsconfig.build.json" }
	]
}
