{
	"globalEnv": ["CI", "BUILD_WITH_COVERAGE"],
	"globalPassThroughEnv": ["CODECOV_TOKEN", "COVERAGE_ENABLED", "SENTRY_AUTH_TOKEN"],
	"boundaries": {
		// `~icons/*` is a vite virtual module injected by unplugin-icons (design-system
		// icon barrel), not a real package — declare it so boundaries doesn't flag it.
		"implicitDependencies": ["~icons"]
	},
	"tasks": {
		"clean": { "cache": false },
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"build:unchecked": {
			"dependsOn": ["^build:unchecked"],
			"outputs": ["dist/**"]
		},
		"MNI-editor-ui#build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		"MNI-editor-ui#build:unchecked": {
			"dependsOn": ["^build:unchecked"],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		// Both emit declarations only under `RELEASE`, so `RELEASE` has to be part of the cache
		// key. Without it a cached non-release `dist`, which has no `.d.ts`, would be restored
		// onto a release build and ship a package with no types.
		"@MNI/design-system#build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		"@MNI/design-system#build:unchecked": {
			"dependsOn": ["^build:unchecked"],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		"@MNI/chat#build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		"@MNI/chat#build:unchecked": {
			"dependsOn": ["^build:unchecked"],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"format": {},
		"format:check": {},
		"lint": {
			"dependsOn": ["^build", "@MNI/eslint-config#build"]
		},
		// Oxlint packages run Oxlint instead of ESLint, so
		// they need the oxlint layer built, not the ESLint one.
		"@MNI/ai-node-sdk#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/backend-common#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/backend-services#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/client-oauth2#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/computer-use#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/config#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/crdt#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/decorators#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/di#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/errors#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/imap#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/local-gateway#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/scheduler#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"@MNI/syslog-client#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		"MNI#lint": {
			"dependsOn": ["^build", "@MNI/oxlint-config#build"]
		},
		// The MNI-nodes-base lint script also validates load-options methods
		// against dist/methods/*.json, which only its own build emits.
		"MNI-nodes-base#lint": {
			"dependsOn": ["^build", "build", "@MNI/eslint-config#build"]
		},
		"lint:fix": {},
		"lint:styles": {
			"dependsOn": ["@MNI/stylelint-config#build"]
		},
		"lint:styles:fix": {
			"dependsOn": ["@MNI/stylelint-config#build"]
		},
		"test": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "COVERAGE_SCOPE"],
			"passThroughEnv": ["CHANGED_FILES"]
		},
		"test:changed": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "CHANGED_FILES"],
			"cache": false
		},
		"test:unit": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "COVERAGE_SCOPE"],
			"passThroughEnv": ["CHANGED_FILES"]
		},
		"test:unit:changed": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "CHANGED_FILES"],
			"cache": false
		},
		"test:integration": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "COVERAGE_SCOPE"],
			"passThroughEnv": ["CHANGED_FILES"]
		},
		"test:integration:changed": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "CHANGED_FILES"],
			"cache": false
		},
		"watch": { "cache": false, "persistent": true },
		"dev": { "cache": false, "persistent": true },
		"install-browsers": {
			"cache": true,
			"inputs": [".playwright-version"],
			"outputs": [".playwright-browsers/**"]
		},
		"test:container:standard": {
			"env": ["E2E_TESTS"],
			"cache": false
		}
	}
}
