# Whitelist approach: ignore everything, then allow only what Docker builds need
# This reduces build context from ~900MB to just what's required

# Ignore everything first
*

# === MNI main image (docker/images/mni/Dockerfile) ===
!compiled
!compiled/**
!THIRD_PARTY_LICENSES.md

# === runners image (docker/images/runners/Dockerfile + Dockerfile.distroless) ===
!dist
!dist/task-runner-javascript
!dist/task-runner-javascript/**
!packages
!packages/@MNI
!packages/@MNI/task-runner-python
!packages/@MNI/task-runner-python/**

# === Docker build files (entrypoints, configs) ===
!docker
!docker/images
!docker/images/mni
!docker/images/mni/docker-entrypoint.sh
!docker/images/runners
!docker/images/runners/MNI-task-runners.json

# === benchmark image (packages/@MNI/benchmark/Dockerfile) ===
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!patches
!patches/**
!scripts
!scripts/**
!packages/@MNI/benchmark
!packages/@MNI/benchmark/**
!packages/@MNI/typescript-config
!packages/@MNI/typescript-config/**

